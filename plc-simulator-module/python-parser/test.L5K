CONTROLLER TestController (ProcessorType := "1756-L73",
                             Major := 20,
                             TimeSlice := 20,
                             ShareUnusedTimeSlice := 1,
                             CommPath := "AB_ETH-1\\192.168.1.100\\1\\0")
    DATATYPE TestUDT (FamilyType := NoFamily)
        Member1 : DINT;
        Member2 : REAL;
        Member3 : BOOL;
    END_DATATYPE

    TAG
        TestTag1 : DINT;
        TestTag2 : REAL := 123.45;
        TestArray : DINT[10];
        TestUDTInstance : TestUDT;
        Timer1 : TIMER;
    END_TAG

    PROGRAM MainProgram
        TAG
            LocalTag1 : INT;
            LocalTag2 : BOOL;
        END_TAG
    END_PROGRAM
END_CONTROLLER