(* L5K-GRAMMAR.md §6.2 fbd_types fixture - D10 regression guard: modelled FBD      *)
(* backing types expand to members; unmodelled ones are counted, never dropped.    *)

IE_VER := 2.11;

CONTROLLER FbdTypes (ProcessorType := "1769-L33ER")
	TAG
	END_TAG

	PROGRAM Drives (Description := "FBD-authored program")
		TAG
			TONR_01 : FBD_TIMER (ExternalAccess := Read/Write) := [0,0,2000,0,0,0,0];
			LES_01 : FBD_COMPARE (ExternalAccess := Read/Write) := [0,0,0.00000000e+000,0.00000000e+000,0];
			OSFI_01 : FBD_ONESHOT (ExternalAccess := Read/Write) := [0,0,0,0];
		END_TAG
		FBD_ROUTINE Flow (SheetSize := "Letter (8.5x11in)", SheetOrientation := Landscape)
			SHEET (Name := "")
			END_SHEET
		END_FBD_ROUTINE
	END_PROGRAM
END_CONTROLLER
