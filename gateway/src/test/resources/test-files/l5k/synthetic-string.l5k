(* L5K-GRAMMAR.md §6.2 string fixture - R4 regression guard: '$NN' escapes, and  *)
(* ';' '[' '"' characters inside single-quoted string bodies must not split the  *)
(* statement or corrupt bracket tracking.                                        *)

IE_VER := 2.11;

CONTROLLER StringFixture (ProcessorType := "1756-L83E")
	TAG
		Greeting : STRING (RADIX := ASCII) := [5,'hello$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00'];
		Msgs : STRING[3] := [[2,'ab$00$00$00$00'],[3,'a;b$00$00$00'],
				[6,'w"x[y]$00$00']];
	END_TAG
END_CONTROLLER
