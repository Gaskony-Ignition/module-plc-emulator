# Module version (build.gradle.kts is source of truth, this is for reference only)
version=9.2.0

# Replace ALL placeholder values below before using this file
# Signing configuration
ignition.signing.keystoreFile=keystore.jks
ignition.signing.keystorePassword=REPLACE_WITH_YOUR_KEYSTORE_PASSWORD
ignition.signing.certFile=certificate.der
ignition.signing.certAlias=plcsimulator
ignition.signing.certPassword=REPLACE_WITH_YOUR_CERT_PASSWORD
