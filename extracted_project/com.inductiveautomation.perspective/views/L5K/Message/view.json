{
  "custom": {},
  "params": {
    "error": true,
    "message": "Test message"
  },
  "propConfig": {
    "params.error": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.message": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 166,
      "width": 314
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Label"
        },
        "position": {
          "height": 0.994,
          "width": 0.7389,
          "x": 0.258,
          "y": 0.006
        },
        "propConfig": {
          "props.style.color": {
            "binding": {
              "config": {
                "expression": "if({view.params.error}, \"#AC0000\", \"#008000\")"
              },
              "type": "expr"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.message"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "fontSize": 28,
            "fontWeight": "bold"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Icon"
        },
        "position": {
          "height": 0.3614,
          "width": 0.1911,
          "x": 0.0462,
          "y": 0.3193
        },
        "propConfig": {
          "props.path": {
            "binding": {
              "config": {
                "expression": "if({view.params.error}, \"material/error\", \"material/message\")"
              },
              "type": "expr"
            }
          }
        },
        "type": "ia.display.icon"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "mode": "percent"
    },
    "type": "ia.container.coord"
  }
}