# Ignition Module Signing Configuration - TEMPLATE
# Copy this file to gradle.properties and fill in your actual credentials
#
# ⚠️  SECURITY WARNING ⚠️
# DO NOT commit gradle.properties with real credentials to version control!
# Use environment variables for CI/CD and production builds.
#
# For production builds, use environment variables:
#   export IGNITION_KEYSTORE_PASSWORD="your-secure-password"
#   export IGNITION_CERT_PASSWORD="your-secure-password"
#   ./gradlew build
#
# For local development:
#   1. Copy this file: cp gradle.properties.template gradle.properties
#   2. Fill in credentials in gradle.properties (NOT committed)
#   3. Or use environment variables as above
#
# To generate new certificates:
#   ./generate-signing-certs.sh

# Module version (build.gradle.kts is source of truth, this is for reference only)
version=9.0.0

# Signing configuration
# Use environment variables if set, otherwise use properties below
ignition.signing.keystoreFile=keystore.jks
ignition.signing.keystorePassword=${IGNITION_KEYSTORE_PASSWORD:-REPLACE_WITH_YOUR_PASSWORD}
ignition.signing.certFile=certificate.der
ignition.signing.certAlias=plcsimulator
ignition.signing.certPassword=${IGNITION_CERT_PASSWORD:-REPLACE_WITH_YOUR_PASSWORD}
