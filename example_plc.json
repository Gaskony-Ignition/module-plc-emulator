{
  "name": "DemoPlant",
  "description": "Example PLC for testing JSON parser",
  "udts": [
    {
      "name": "PumpControl",
      "description": "Pump control UDT",
      "members": [
        {"name": "Running", "data_type": "BOOL", "initial_value": false, "description": "Pump running status"},
        {"name": "Speed", "data_type": "REAL", "initial_value": 0.0, "description": "Pump speed (%)"},
        {"name": "FlowRate", "data_type": "REAL", "initial_value": 0.0, "description": "Flow rate (GPM)"},
        {"name": "Pressure", "data_type": "REAL", "initial_value": 0.0, "description": "Discharge pressure (PSI)"},
        {"name": "Alarms", "data_type": "INT", "initial_value": 0, "description": "Alarm bit field"}
      ]
    },
    {
      "name": "TankLevel",
      "description": "Tank level monitoring",
      "members": [
        {"name": "Level", "data_type": "REAL", "initial_value": 50.0, "description": "Tank level (%)"},
        {"name": "Volume", "data_type": "REAL", "initial_value": 0.0, "description": "Tank volume (gal)"},
        {"name": "HighAlarm", "data_type": "BOOL", "initial_value": false, "description": "High level alarm"},
        {"name": "LowAlarm", "data_type": "BOOL", "initial_value": false, "description": "Low level alarm"}
      ]
    },
    {
      "name": "AnalogInput",
      "description": "Generic analog input",
      "members": [
        {"name": "Raw", "data_type": "INT", "initial_value": 0, "description": "Raw ADC value"},
        {"name": "Scaled", "data_type": "REAL", "initial_value": 0.0, "description": "Scaled value"},
        {"name": "EU_Min", "data_type": "REAL", "initial_value": 0.0, "description": "Engineering units min"},
        {"name": "EU_Max", "data_type": "REAL", "initial_value": 100.0, "description": "Engineering units max"},
        {"name": "Valid", "data_type": "BOOL", "initial_value": true, "description": "Signal valid"}
      ]
    }
  ],
  "global_tags": [
    {
      "name": "SystemRunning",
      "data_type": "BOOL",
      "initial_value": false,
      "description": "Overall system running status"
    },
    {
      "name": "ProductionCount",
      "data_type": "INT",
      "initial_value": 0,
      "description": "Total production count"
    },
    {
      "name": "Pump1",
      "data_type": "PumpControl",
      "description": "Primary feed pump"
    },
    {
      "name": "Pump2",
      "data_type": "PumpControl",
      "description": "Secondary feed pump"
    },
    {
      "name": "Tank1",
      "data_type": "TankLevel",
      "description": "Raw material tank"
    },
    {
      "name": "Tank2",
      "data_type": "TankLevel",
      "description": "Product tank"
    },
    {
      "name": "Temperature1",
      "data_type": "AnalogInput",
      "description": "Reactor temperature"
    },
    {
      "name": "Temperature2",
      "data_type": "AnalogInput",
      "description": "Outlet temperature"
    },
    {
      "name": "Pressure1",
      "data_type": "AnalogInput",
      "description": "System pressure"
    },
    {
      "name": "EmergencyStop",
      "data_type": "BOOL",
      "initial_value": false,
      "description": "Emergency stop button"
    },
    {
      "name": "SetPoint",
      "data_type": "REAL",
      "initial_value": 75.0,
      "description": "Process setpoint"
    }
  ],
  "programs": [
    {
      "name": "MainControl",
      "description": "Main control program",
      "tags": [
        {"name": "CycleTimer", "data_type": "INT", "initial_value": 0, "description": "Cycle timer"},
        {"name": "StepNumber", "data_type": "INT", "initial_value": 0, "description": "Current step"},
        {"name": "BatchActive", "data_type": "BOOL", "initial_value": false, "description": "Batch in progress"}
      ]
    },
    {
      "name": "Alarms",
      "description": "Alarm management",
      "tags": [
        {"name": "ActiveAlarms", "data_type": "INT", "initial_value": 0, "description": "Number of active alarms"},
        {"name": "AlarmHistory", "data_type": "INT", "initial_value": 0, "description": "Total alarms"}
      ]
    }
  ]
}
